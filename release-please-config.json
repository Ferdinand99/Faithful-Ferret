{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "release-as": "0.1.0",
      "package-name": "faithful-ferret-core",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='ferret-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='ferret-core-wasm')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='ferret-vectorgen')].version" },
        { "type": "toml", "path": "fuzz/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='ferret-core')].version" },
        { "type": "toml", "path": "ct/dudect/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='ferret-core')].version" }
      ]
    }
  }
}
