{
  "manifest_version": 2,
  "browser_action": {
    "default_title": "Faithful Ferret",
    "default_popup": "pages/about.html"
  },
  "background": {
    "page": "background/background.html",
    "persistent": true
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
}
