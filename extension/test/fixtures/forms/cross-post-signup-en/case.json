{
  "id": "cross-post-signup-en",
  "class": "special",
  "category": "cross-post",
  "lang": "en",
  "host": "forms.example.net",
  "path": "/cross-post-signup-en/",
  "frame": null,
  "steps": [
    {
      "type": "#email",
      "text": "anna@example.net"
    },
    {
      "type": "#pw",
      "text": "Zq7!crossposts-Vm4$"
    },
    {
      "type": "#pw2",
      "text": "Zq7!crossposts-Vm4$"
    },
    {
      "click": "#go"
    }
  ],
  "expect": {
    "fill": null,
    "allow": [
      "#email"
    ],
    "generated": null,
    "capture": {
      "offer": "save",
      "username": "anna@example.net",
      "password_from": "#pw",
      "origin": "https://forms.example.net"
    }
  },
  "must_stay_empty": [
    "#pw",
    "#pw2"
  ],
  "fields": {
    "#pw": "new_password",
    "#pw2": "confirm_password"
  },
  "source": "own"
}
