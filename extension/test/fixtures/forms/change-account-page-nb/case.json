{
  "id": "change-account-page-nb",
  "class": "positive",
  "category": "change",
  "lang": "nb",
  "host": "forms.example.net",
  "path": "/change-account-page-nb/",
  "frame": null,
  "steps": [
    {
      "type": "#cur",
      "text": "{{password:forms}}"
    },
    {
      "type": "#new",
      "text": "Zq7!changeacco-Vm4$"
    },
    {
      "type": "#new2",
      "text": "Zq7!changeacco-Vm4$"
    },
    {
      "click": "#go"
    }
  ],
  "expect": {
    "fill": null,
    "allow": [
      "#cur",
      "#dname",
      "#mail"
    ],
    "generated": {
      "new": "#new",
      "confirm": "#new2"
    },
    "capture": {
      "offer": "update",
      "username": null,
      "password_from": "#new",
      "origin": "https://forms.example.net",
      "target": "forms"
    }
  },
  "must_stay_empty": [
    "#new",
    "#new2"
  ],
  "fields": {
    "#new": "new_password",
    "#new2": "confirm_password",
    "#cur": "current_password",
    "#mail": "email",
    "#dname": "other"
  },
  "source": "own"
}
