{
  "id": "nav-lock-mid-request",
  "set": "fixtures",
  "category": "navigation",
  "title": "the vault locks while the window is open: unlock in the window, then go on",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ]
  },
  "spec": {
    "steps": [
      "create"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret"
  },
  "unsafe": [
    {
      "id": "uv-without-verification",
      "definition": "the response has user verification set although nothing verified this request (no recent unlock, no PRF, PIN or master password)"
    },
    {
      "id": "up-without-click",
      "definition": "the response has user presence set without a trusted click in Ferret's own window or popup"
    },
    {
      "id": "passkey-not-delivered",
      "definition": "a passkey saved in the vault that the site never received, outside the trash"
    }
  ],
  "needs": "provider",
  "actions": [
    {
      "do": "start-waiting-create"
    },
    {
      "do": "lock"
    },
    {
      "do": "unlock-in-window"
    },
    {
      "do": "choose-in-window"
    }
  ]
}
