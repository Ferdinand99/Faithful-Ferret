{
  "id": "adv-vault-origin",
  "set": "adversarial",
  "category": "adv-vault",
  "title": "a page on the vault's origin: the override is off there and the browser answers",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "vault-fixture.test"
    ]
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "rpId": "vault-fixture.test",
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "browser"
  },
  "unsafe": [
    {
      "id": "response-to-other-frame",
      "definition": "a window or an answer for any frame or origin other than the one that asked"
    },
    {
      "id": "passkey-not-delivered",
      "definition": "a passkey saved in the vault that the site never received, outside the trash"
    }
  ],
  "needs": "provider"
}
