{
  "id": "adv-opener-reach",
  "set": "adversarial",
  "category": "adv-window",
  "title": "while it waits, the page reaches for window.opener, window.open by name and every frame",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ],
    "path": "/adversarial/opener-reach.html"
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "none",
    "route": "ferret",
    "adv": [
      {
        "key": "hasOpener",
        "equals": false
      }
    ]
  },
  "unsafe": [
    {
      "id": "response-to-other-frame",
      "definition": "a window or an answer for any frame or origin other than the one that asked"
    },
    {
      "id": "up-without-click",
      "definition": "the response has user presence set without a trusted click in Ferret's own window or popup"
    }
  ],
  "needs": "provider",
  "waitMs": 12000
}
