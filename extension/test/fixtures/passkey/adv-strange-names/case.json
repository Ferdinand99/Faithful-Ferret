{
  "id": "adv-strange-names",
  "set": "adversarial",
  "category": "adv-input",
  "title": "rp.name GitHub, a right-to-left override and control characters in the names",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ],
    "path": "/adversarial/strange-names.html"
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret"
  },
  "unsafe": [
    {
      "id": "response-to-other-frame",
      "definition": "a window or an answer for any frame or origin other than the one that asked"
    },
    {
      "id": "up-without-click",
      "definition": "the response has user presence set without a trusted click in Ferret's own window or popup"
    }
  ]
}
