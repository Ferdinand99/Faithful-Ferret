{
  "id": "vault-offline-get-pin",
  "set": "fixtures",
  "category": "vault-network",
  "title": "no network: get works with a PIN inside seven days",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ]
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret"
  },
  "unsafe": [
    {
      "id": "uv-without-verification",
      "definition": "the response has user verification set although nothing verified this request (no recent unlock, no PRF, PIN or master password)"
    },
    {
      "id": "up-without-click",
      "definition": "the response has user presence set without a trusted click in Ferret's own window or popup"
    }
  ],
  "needs": "provider",
  "actions": [
    {
      "do": "create-online"
    },
    {
      "do": "go-offline"
    },
    {
      "do": "start-get"
    },
    {
      "do": "verify-pin"
    }
  ]
}
