{
  "id": "origin-github-user-self",
  "set": "fixtures",
  "category": "origin-rpid",
  "title": "user.github.io with its own RP ID: allowed",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "user.github.io"
    ]
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "rpId": "user.github.io",
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret"
  },
  "unsafe": [
    {
      "id": "uv-without-verification",
      "definition": "the response has user verification set although nothing verified this request (no recent unlock, no PRF, PIN or master password)"
    },
    {
      "id": "up-without-click",
      "definition": "the response has user presence set without a trusted click in Ferret's own window or popup"
    },
    {
      "id": "key-outside-core",
      "definition": "a private key or a PRF seed anywhere but inside the WASM core"
    }
  ]
}
