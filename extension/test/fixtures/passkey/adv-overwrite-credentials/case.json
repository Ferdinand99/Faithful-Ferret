{
  "id": "adv-overwrite-credentials",
  "set": "adversarial",
  "category": "adv-bridge",
  "title": "the page overwrites navigator.credentials and the prototype after load and calls through its wrapper",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ],
    "path": "/adversarial/overwrite-credentials.html"
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret"
  },
  "unsafe": [
    {
      "id": "response-to-other-frame",
      "definition": "a window or an answer for any frame or origin other than the one that asked"
    },
    {
      "id": "uv-without-verification",
      "definition": "the response has user verification set although nothing verified this request (no recent unlock, no PRF, PIN or master password)"
    }
  ]
}
