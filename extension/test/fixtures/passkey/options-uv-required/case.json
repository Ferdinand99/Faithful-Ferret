{
  "id": "options-uv-required",
  "set": "fixtures",
  "category": "create-options",
  "title": "userVerification required on create and get",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ]
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "required",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
