{
  "id": "frame-nested-a-b-a-get",
  "set": "fixtures",
  "category": "frames",
  "title": "rp-a.test inside rp-b.test inside rp-a.test, with allow for get on both levels: a foreign ancestor, the browser decides",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test",
      "rp-b.test",
      "rp-a.test"
    ],
    "allow": [
      "publickey-credentials-get",
      "publickey-credentials-get"
    ]
  },
  "spec": {
    "steps": [
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "rpId": "rp-a.test",
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "unknown",
      "timeout": 3000
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "client-error",
    "route": "browser",
    "error": "NotAllowedError"
  },
  "unsafe": [
    {
      "id": "response-to-other-frame",
      "definition": "a window or an answer for any frame or origin other than the one that asked"
    },
    {
      "id": "response-to-foreign-ancestor",
      "definition": "an answer to a frame that has an ancestor of another origin than the top"
    },
    {
      "id": "signature-for-other-rp-id",
      "definition": "a signature made for an RP ID other than the one the stored passkey holds, exactly"
    }
  ],
  "waitMs": 10000
}
