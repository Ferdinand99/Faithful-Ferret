{
  "id": "adv-window-storm",
  "set": "adversarial",
  "category": "adv-window",
  "title": "eight cancelled requests in a row, then a real one: never more than one window, a calm period",
  "rp": {
    "lib": "rs",
    "client": "manual"
  },
  "page": {
    "chain": [
      "rp-a.test"
    ],
    "path": "/adversarial/window-storm.html"
  },
  "spec": {
    "steps": [
      "create",
      "get"
    ],
    "user": {
      "name": "alice",
      "displayName": "Alice"
    },
    "create": {
      "userVerification": "preferred",
      "residentKey": "preferred",
      "attestation": "none"
    },
    "get": {
      "userVerification": "preferred",
      "allow": "all"
    }
  },
  "gesture": "click",
  "expected": {
    "ceremony": "ok",
    "route": "ferret",
    "maxWindows": 1
  },
  "unsafe": [
    {
      "id": "window-without-gesture",
      "definition": "a Ferret window although the page had no user activation"
    },
    {
      "id": "error-differs",
      "definition": "an error type or a time that tells the page whether Ferret has a passkey for it (no match against cancelled)"
    }
  ],
  "needs": "provider",
  "waitMs": 40000
}
