{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ferdinand99/Faithful-Ferret/vectors/schema/vector-file.schema.json",
  "title": "Ferret test-vector file",
  "description": "ferret-vectors/1. Bytes are lowercase hex without prefix; u64 values are decimal strings; every key is synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "group", "suite", "spec", "generator", "cases"],
  "properties": {
    "format": { "const": "ferret-vectors/1" },
    "group": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "suite": { "type": "integer", "minimum": 1 },
    "spec": { "type": "string", "minLength": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "core", "commit", "unicode", "rng"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "core": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "unicode": { "type": "string", "minLength": 1 },
        "rng": { "type": "string", "minLength": 1 }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "op", "status", "tags", "synthetic", "rng", "input", "expect_error"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+(/[a-z0-9_.-]+)+$" },
        "title": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "status": { "enum": ["valid", "invalid"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["slow", "native-only", "external"] }
        },
        "synthetic": { "const": true },
        "skip_reason": { "type": "string", "minLength": 1 },
        "rng": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "input": { "type": "object" },
        "intermediate": { "type": "object" },
        "expect": {},
        "expect_error": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "valid" } } },
          "then": { "required": ["expect"], "properties": { "expect_error": { "type": "null" } } },
          "else": { "not": { "required": ["expect"] }, "properties": { "expect_error": { "type": "string" } } }
        },
        {
          "if": { "properties": { "tags": { "contains": { "const": "native-only" } } } },
          "then": { "required": ["skip_reason"] }
        }
      ]
    }
  }
}
