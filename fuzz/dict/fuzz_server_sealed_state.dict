# fuzz_server_sealed_state: the first byte picks the way (0 a blob, 1 content to
# seal, 2 the plaintext, 3 a ServerLogin and a KE3). A blob is version 1, a
# 24 byte nonce, the ciphertext of the 203 byte plaintext, and a 16 byte tag.
# The plaintext is expires_at (8), purpose (1), flag (1), binding (48),
# credential (16), profile (1) and the ServerLogin (128).
select_blob="\x00"
select_seal="\x01"
select_plaintext="\x02"
select_server_login="\x03"
blob_version="\x01"
purpose_login="\x00\x00"
purpose_reauth="\x01\x01"
purpose_mixed="\x00\x01"
purpose_unknown="\x02\x00"
expires_zero="\x00\x00\x00\x00\x00\x00\x00\x00"
expires_max="\xff\xff\xff\xff\xff\xff\xff\xff"
binding_zero="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
login_zero="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
login_ones="\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
tag_zero="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
