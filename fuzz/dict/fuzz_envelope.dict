# fuzz_envelope: the unkeyed half starts with version, suite, kind. The first
# byte of the keyed half is a mode (bit 0 manifest, bit 1 already padded).
header_item="\x01\x01\x01"
header_manifest="\x01\x01\x02"
header_bad_version="\x02\x01\x01"
header_bad_suite="\x01\x02\x01"
header_bad_kind="\x01\x01\x03"
mode_item_plain="\x00"
mode_manifest_plain="\x01"
mode_item_padded="\x02"
mode_manifest_padded="\x03"
marker="\x80"
pad_tail="\x80\x00\x00\x00\x00\x00\x00\x00"
pad_double_marker="\x80\x80"
cbor_empty_map="\xa0"
cbor_schema_1="\xa1\x66schema\x01"
cbor_schema_2="\xa1\x66schema\x02"
cbor_v1="\xa1\x61v\x01"
cbor_vk_epoch_1="\x68vk_epoch\x01"
cbor_body_head="\xa8\x66schema\x01\x64type\x65login\x64name"
cbor_indef="\xbf"
cbor_break="\xff"
