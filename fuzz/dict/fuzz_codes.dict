# fuzz_codes: recovery key (FFR1, 52 data symbols and 4 check symbols) and
# secret key (FFS1, 26 and 4). Crockford base 32, groups joined by separators.
rk_prefix="FFR1-"
sk_prefix="FFS1-"
rk_prefix_lower="ffr1-"
sk_prefix_lower="ffs1-"
rk_prefix_nodash="FFR1"
sk_prefix_nodash="FFS1"
group4_zero="0000-"
group4_z="ZZZZ-"
group5_zero="00000-"
digits="0123456789"
letters="ABCDEFGHJKMNPQRSTVWXYZ"
lookalike_o="O"
lookalike_i="I"
lookalike_l="L"
excluded_u="U"
dash="-"
space=" "
tab="\x09"
nbsp="\xc2\xa0"
en_dash="\xe2\x80\x93"
em_dash="\xe2\x80\x94"
zero_groups="0000-0000-0000-0000"
spare_bits="ZZZG"
