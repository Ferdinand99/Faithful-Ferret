# fuzz_server_wire_fields: the first byte picks the field (0 a login id, 1 a
# stored scope, 2 and then every third value a nonce and a proof, led by the
# length of the nonce).
select_login_id="\x00"
select_scope="\x01"
select_proof="\x02"
select_proof_password_put="\x08"
select_proof_recover="\x0e"
nonce_length="\x20"
scope_full="full"
scope_pending="pending_2fa"
scope_reset="account_reset"
scope_unverified="unverified"
scope_upper="FULL"
scope_pending_dash="pending-2fa"
scope_space=" full"
hex_lower="0123456789abcdef"
hex_upper="ABCDEF"
hex_prefix="0x"
id_zero="00000000000000000000000000000000"
id_ones="ffffffffffffffffffffffffffffffff"
zeros_32="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
