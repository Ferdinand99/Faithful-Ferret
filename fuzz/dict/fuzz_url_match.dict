# fuzz_url_match: a kind byte, the saved address, a NUL byte, then the page address.
nul="\x00"
kind_host="\x00"
kind_domain="\x01"
kind_exact="\x02"
kind_other="\x03"
https="https://"
http="http://"
data="data:"
blob="blob:"
file="file://"
about_blank="about:blank"
javascript="javascript:"
moz_ext="moz-extension://"
userinfo="user:pw@"
at="@"
backslash="\\"
tab="\x09"
newline="\x0a"
carriage_return="\x0d"
space=" "
percent_dot="%2E"
percent_slash="%2F"
percent_e="%65"
xn="xn--"
xn_bad="xn--a"
fullwidth_dot="\xef\xbc\x8e"
ideographic_dot="\xe3\x80\x82"
cyrillic_a="\xd0\xb0"
sharp_s="\xc3\x9f"
ipv4_decimal="3232235777"
ipv4_hex="0xc0a80101"
ipv4_octal="0300.0250.01.01"
ipv4_short="192.168.257"
ipv6_loopback="[::1]"
ipv6_full="[0:0:0:0:0:0:0:1]"
ipv6_open="[::1"
port_443=":443"
port_80=":80"
port_zero=":0"
port_big=":99999"
trailing_dot="."
double_dot=".."
dot_co_uk=".co.uk"
github_io="github.io"
