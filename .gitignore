/target/
/pkg-web/
/pkg-node/
node_modules/
*.log

# WebAssembly packages built by scripts/lanbox-wasm.sh
/bindings/wasm/pkg-*
/bindings/wasm/node_modules

# Output of the browser tests
/tests/browser/results/

# Output of scripts/lanbox-coverage.sh
/target-cov/

# Output of the constant-time runs (ct/run.sh); only the decisive dudect result
# written by scripts/lanbox-ct.sh, and other notes in .md files, are committed
/ct/results/*
!/ct/results/*.md

# Local deploy settings (setup token, proxy addresses); never committed
.env

# Screenshots and output of the end-to-end gate (scripts/lanbox-ferret-e2e-gate.sh m2)
/test-results/

# The stack for real data (docker/compose.ferret-home.yml): its settings, the SSH key of the copy
# container, and the record of the images it was started with. Never committed.
/docker/home.env
/docker/copy.env
/docker/secrets/
/docker/home-image
/docker/home-releases.log
