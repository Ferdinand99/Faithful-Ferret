/target/
/pkg-web/
/pkg-node/
node_modules/
*.log

# WebAssembly packages built by scripts/lanbox-wasm.sh
/bindings/wasm/pkg-*
/bindings/wasm/node_modules

# Output of the browser tests
/tests/browser/results/

# Output of scripts/lanbox-coverage.sh
/target-cov/

# Output of the constant-time runs (ct/run.sh); only the decisive dudect result
# written by scripts/lanbox-ct.sh, and other notes in .md files, are committed
/ct/results/*
!/ct/results/*.md

# Local deploy settings (setup token, proxy addresses); never committed
.env
