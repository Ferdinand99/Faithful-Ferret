# The settings of the Faithful Ferret server on a stack with real data
# (docker/compose.ferret-home.yml). Copy this file to docker/home.env, fill in every
# value, and keep it out of git (it is ignored) and out of every shared place: it holds
# secrets. Only docker compose reads home.env; no script of the repository does.
# The names are the server's own settings; this file lists only the ones that vary
# from stack to stack. The compose file sets the rest.

# The public address of the web vault, https://<host>. The Origin check compares with it.
FERRET_VAULT_URL=

# The public address of the admin pages, https://<another host>. It must have another
# host name than the vault (cookies do not tell ports apart).
FERRET_ADMIN_URL=

# A long random string that lets the first account be made. It is needed only until the
# first account exists; make it up yourself (for example `head -c 32 /dev/urandom | base64`).
FERRET_SETUP_TOKEN=

# The push address of the uptime monitor that the server tells after every checked backup
# set (the push URL of a "push" monitor). A secret. Leave empty to send nothing.
FERRET_BACKUP_PUSH_URL=
