# The settings of the copy container on a stack with real data
# (docker/compose.ferret-home.yml). Copy this file to docker/copy.env, fill in every
# value, and keep it out of git (it is ignored). Only docker compose reads copy.env; no
# script of the repository does. The private SSH key is not here: it is the file
# docker/secrets/copy_sftp_key (owned by uid 1000, mode 0400).

# The PUBLIC key that every copy is encrypted to (it starts with age1). The matching
# private key must never be on this machine; the container refuses to run if it finds one.
FERRET_BACKUP_AGE_RECIPIENT=

# The SFTP target: its address as this machine reaches it, the port, and the account that
# logs in with the key only.
FERRET_COPY_SFTP_HOST=
FERRET_COPY_SFTP_PORT=
FERRET_COPY_SFTP_USER=

# The public host key of the target, one line as in a known_hosts file (ssh-ed25519 AAAA...).
# The target is never trusted on first use: a different key stops the copy.
FERRET_COPY_SFTP_HOST_KEY=

# The folder on the target to write to, inside the folder the account is locked to.
# Only this folder is touched; the old copies in it are trimmed after 30 days (the three
# newest always stay).
FERRET_COPY_SFTP_DIR=

# The push address of the uptime monitor that the copy container tells after every copy
# that was checked on the target. A secret. Leave empty to send nothing.
FERRET_COPY_PUSH_URL=
